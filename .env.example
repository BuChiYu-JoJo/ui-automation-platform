# --- infra ---
POSTGRES_USER=uip
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=uip
DATABASE_URL=postgresql://uip:change-me-local-only@localhost:5432/uip?schema=public
REDIS_URL=redis://localhost:6379
# --- minio / S3 ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=uip-artifacts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-local-only
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-local-only
# --- app ---
API_PORT=3000
WEB_PORT=5173
JWT_SECRET=dev-only-change-me
# envelope encryption master key: 32 bytes, base64
MASTER_KEY_B64=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# worker
WORKER_CONCURRENCY=4
WORKER_MAX_CONTEXTS_PER_BROWSER=20
WORKER_MAX_EXECUTIONS_PER_BROWSER=200
ALLOW_EVAL_JS=false
