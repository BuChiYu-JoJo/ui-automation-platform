{
  "name": "@uip/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "pnpm build && mkdir -p dist/__tests__/fixtures && cp src/__tests__/fixtures/*.json dist/__tests__/fixtures/ && node --test \"dist/__tests__/*.test.js\""
  },
  "dependencies": {
    "@uip/dsl": "workspace:*",
    "@uip/shared": "workspace:*",
    "bullmq": "^5.0.0",
    "ioredis": "^5.0.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.0.0"
  }
}